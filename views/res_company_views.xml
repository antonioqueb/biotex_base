<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_biotex" model="ir.ui.view">
        <field name="name">res.company.form.biotex</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Distribución" name="biotex">
                    <group>
                        <field name="biotex_short_name"/>
                        <field name="biotex_is_default_buyer"/>
                    </group>
                    <label for="biotex_remision_footer"/>
                    <field name="biotex_remision_footer"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
