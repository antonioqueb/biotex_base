<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_biotex" model="ir.ui.view">
        <field name="name">res.users.form.biotex</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delegaciones" name="biotex">
                    <group>
                        <field name="biotex_warehouse_ids" widget="many2many_tags"/>
                        <field name="biotex_default_warehouse_id" domain="[('id', 'in', biotex_warehouse_ids)]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
