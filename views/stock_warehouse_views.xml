<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_biotex" model="ir.ui.view">
        <field name="name">stock.warehouse.form.biotex</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delegación Biotex" name="biotex">
                    <group>
                        <group string="Identidad">
                            <field name="biotex_is_delegation"/>
                            <field name="biotex_is_central"/>
                            <field name="biotex_state_name"/>
                            <field name="biotex_covered_zones"/>
                        </group>
                        <group string="Responsables">
                            <field name="biotex_responsible_id" widget="many2one_avatar_user"/>
                            <field name="biotex_coordinator_id" widget="many2one_avatar_user"/>
                            <field name="biotex_whatsapp_group"/>
                        </group>
                    </group>
                    <field name="biotex_notes" placeholder="Notas operativas de la delegación..."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_list_biotex" model="ir.ui.view">
        <field name="name">stock.warehouse.list.biotex</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="biotex_state_name" optional="show"/>
                <field name="biotex_responsible_id" widget="many2one_avatar_user" optional="show"/>
                <field name="biotex_coordinator_id" widget="many2one_avatar_user" optional="show"/>
                <field name="biotex_is_central" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="action_biotex_delegations" model="ir.actions.act_window">
        <field name="name">Delegaciones</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('biotex_is_delegation', '=', True)]</field>
        <field name="context">{'default_biotex_is_delegation': True}</field>
    </record>
</odoo>
